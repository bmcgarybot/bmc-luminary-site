  "sequence": [
    {
      "step": 1,
      "subject": "A few potential customers in {market}",
      "body": "Hi {name}, we research business prospects for {service} companies serving {market}. If useful, I can prepare five free business targets with source links and contact routes. The full pack is 100 targets for $499, including those five. These are researched prospects; they have not requested your service. Would you like the five?"
    },
    {
      "step": 2,
      "subject": "Your {market} target sample",
      "body": "Here are the five business targets you requested for {service} in {market}: {sample_link}. The full pack contains 100 total for $499. It is available only after we confirm enough suitable records. No subscription and no promise of sales."
    },
    {
      "step": 3,
      "subject": "Checking back on the {market} sample",
      "body": "Was the sample relevant to the jobs you want? Reply with any scope changes before ordering. If it is useful, the full 100 is $499. Reply stop to end follow-ups."
    },
    {
      "step": 4,
      "subject": "Your service-business research request",
      "body": "We received your request for {service} in {market}. We will confirm whether we can research three suitable service businesses before offering the $49 shortlist. Service quotes, availability, contracts and service payments are handled directly with each business."
    },
    {
      "step": 5,
      "subject": "Your {market} service shortlist",
      "body": "Your researched options and quote checklist are ready: {delivery_link}. These businesses have not been contacted on your behalf. Please confirm current availability, insurance, credentials and final scope directly before hiring."
    }
