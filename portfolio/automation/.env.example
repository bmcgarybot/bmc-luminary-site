# Copy to .env and replace every CHANGE_ME value.

# Deployment identity. COMPOSE_PROJECT_NAME namespaces Docker resources so the
# same engine can later be cloned as an isolated white-label instance.
COMPOSE_PROJECT_NAME=bmc
INSTANCE_KEY=bmc
INSTANCE_NAME=BMC Luminary Ventures LLC
DEPLOYMENT_TARGET=cloud-vps

POSTGRES_USER=bmc_automation
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
POSTGRES_DB=bmc_portfolio
N8N_ENCRYPTION_KEY=CHANGE_ME_32_PLUS_RANDOM_CHARS

PUBLIC_SITE_URL=https://bmcservicenetwork.com
WEBHOOK_URL=https://hooks.bmcservicenetwork.com/
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_AFTER_TUNNEL_SETUP
BMC_ADMIN_KEY=CHANGE_ME_LONG_RANDOM_ADMIN_KEY
OFFER_HOURS=2

# Outbound transactional email for lead confirmations and provider offers.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=contact@bmcservicenetwork.com
SMTP_STARTTLS=true
SMTP_DRY_RUN=false

# Optional utility AI on the VPS.
# qwen3:1.7b is the conservative resident model for an 8 GB host.
# Core intake/routing works without Ollama; keep consequential actions gated.
LOCAL_AI_ENABLED=true
LOCAL_AI_URL=http://ollama:11434
LOCAL_AI_MODEL=qwen3:1.7b

# Bounded autonomous operator. V1 may classify/triage/queue internal work only.
# It never sends prospecting, approves providers, changes credentials, or moves money.
AGENT_ENABLED=true
AGENT_MIN_CONFIDENCE=0.82
AGENT_CYCLE_LIMIT=10
AGENT_RESEARCH_TASK_LIMIT=5
AGENT_ALLOW_EXTERNAL_ACTIONS=false

# Private self-hosted research search. Search results are staged for review;
# they do not activate providers or send outreach.
RESEARCH_SEARCH_ENABLED=true
RESEARCH_SEARCH_URL=http://searxng:8080/search
RESEARCH_SEARCH_RESULTS=8
RESEARCH_WORKER_BATCH=1
RESEARCH_MAX_PASSES=4
RESEARCH_AUTO_PROMOTE_CONTACTS=true
SOURCE_NATIVE_RESEARCH_ENABLED=true
SOURCE_NATIVE_CHECK_BATCH=10
SOURCE_NATIVE_MARKETS=Prescott,Prescott Valley,Chino Valley,Dewey-Humboldt,Mayer,Cordes Lakes,Williamson Valley,Ash Fork,Seligman,Skull Valley,Camp Verde,Cottonwood,Sedona,Flagstaff,Winslow,Kingman,Golden Valley,Bullhead City,Phoenix,Scottsdale,Tucson
ADHS_FACILITIES_URL=https://services1.arcgis.com/mpVYz37anSdrK4d8/ArcGIS/rest/services/All_State_Licensed_Facilities_in_Arizona/FeatureServer/18/query
ADHS_SOURCE_NATIVE_PAGE_SIZE=100
CMS_SOURCE_NATIVE_ENABLED=true
CMS_SOURCE_NATIVE_PAGE_SIZE=100
CMS_HOSPITALS_URL=https://data.cms.gov/provider-data/api/1/datastore/query/xubh-q36u/0
CMS_NURSING_HOMES_URL=https://data.cms.gov/provider-data/api/1/datastore/query/4pq5-n9py/0
CMS_HOME_HEALTH_URL=https://data.cms.gov/provider-data/api/1/datastore/query/6jpm-sxkc/0
CMS_HOSPICE_URL=https://data.cms.gov/provider-data/api/1/datastore/query/yc9t-dgbk/0
CMS_BULK_DOWNLOAD_ENABLED=true
CMS_METADATA_BASE=https://data.cms.gov/provider-data/api/1/metastore/schemas/dataset/items
CMS_BULK_CACHE_TTL_SECONDS=21600
SEARXNG_SECRET=CHANGE_ME_SEARXNG_SECRET

# Outbound prospecting is intentionally OFF until sender/address/reply handling are ready.
OUTREACH_ENABLED=false
OUTREACH_DAILY_LIMIT=25
OUTREACH_WAVE=pilot1
BUSINESS_POSTAL_ADDRESS=CHANGE_ME_REAL_BMC_POSTAL_ADDRESS

# Buyer acquisition is controlled separately from vendor recruitment.
BUYER_OUTREACH_ENABLED=false
BUYER_OUTREACH_DAILY_LIMIT=15
BUYER_OUTREACH_WAVE=pilot1

# Growth Pack sales are a third outbound lane so service-business prospecting can be tested
# independently of facility-buyer acquisition and provider recruitment.
GROWTH_OUTREACH_ENABLED=false
GROWTH_OUTREACH_DAILY_LIMIT=10
GROWTH_OUTREACH_WAVE=growth1

# Optional inbox polling for automatic reply/opt-out handling.
IMAP_ENABLED=false
IMAP_HOST=mail.privateemail.com
IMAP_PORT=993
IMAP_USER=CHANGE_ME
IMAP_PASSWORD=CHANGE_ME
IMAP_FOLDER=INBOX

# Stripe webhook is safe to leave disabled until Stripe creates the endpoint secret.
STRIPE_WEBHOOK_SECRET=CHANGE_ME_STRIPE_WEBHOOK_SECRET

# Portable local database backups. Provider snapshots do not replace pg_dump.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
