# Copy to .env and replace every CHANGE_ME value.
POSTGRES_USER=bmc_automation
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
POSTGRES_DB=bmc_portfolio
N8N_ENCRYPTION_KEY=CHANGE_ME_32_PLUS_RANDOM_CHARS

PUBLIC_SITE_URL=https://bmcluminaryventures.com
WEBHOOK_URL=https://hooks.bmcluminaryventures.com/
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_AFTER_TUNNEL_SETUP
BMC_ADMIN_KEY=CHANGE_ME_LONG_RANDOM_ADMIN_KEY
OFFER_HOURS=2

# Outbound transactional email for lead confirmations and provider offers.
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=contact@bmcluminaryventures.com
SMTP_STARTTLS=true
SMTP_DRY_RUN=false

# Optional utility AI on the automation appliance.
LOCAL_AI_ENABLED=true
LOCAL_AI_URL=http://ollama:11434
LOCAL_AI_MODEL=qwen3:1.7b

# Bounded autonomous operator. V1 may classify/triage/queue internal work only.
# It never sends prospecting, approves providers, changes credentials, or moves money.
AGENT_ENABLED=true
AGENT_MIN_CONFIDENCE=0.82
AGENT_CYCLE_LIMIT=10
AGENT_RESEARCH_TASK_LIMIT=5
AGENT_ALLOW_EXTERNAL_ACTIONS=false

# Private self-hosted research search. Search results are staged for review;
# they do not activate providers or send outreach.
RESEARCH_SEARCH_ENABLED=true
RESEARCH_SEARCH_URL=http://searxng:8080/search
RESEARCH_SEARCH_RESULTS=8
RESEARCH_WORKER_BATCH=1
SEARXNG_SECRET=CHANGE_ME_SEARXNG_SECRET

# Outbound prospecting is intentionally OFF until sender/address/reply handling are ready.
OUTREACH_ENABLED=false
OUTREACH_DAILY_LIMIT=25
OUTREACH_WAVE=pilot1
BUSINESS_POSTAL_ADDRESS=CHANGE_ME_REAL_BMC_POSTAL_ADDRESS

# Buyer acquisition is controlled separately from vendor recruitment.
BUYER_OUTREACH_ENABLED=false
BUYER_OUTREACH_DAILY_LIMIT=15
BUYER_OUTREACH_WAVE=pilot1

# Optional inbox polling for automatic reply/opt-out handling.
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=CHANGE_ME
IMAP_PASSWORD=CHANGE_ME
IMAP_FOLDER=INBOX

# Stripe webhook is safe to leave disabled until Stripe creates the endpoint secret.
STRIPE_WEBHOOK_SECRET=CHANGE_ME_STRIPE_WEBHOOK_SECRET
